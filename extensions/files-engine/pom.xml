<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>files-engine</artifactId>
  <packaging>jar</packaging>

  <name>JinRefine - Files Engine</name>
  <description>Pure file tools sunk out of FilesExtension (unit scanning, natural order, title splitting, extraction templates/DTOs, AIMP LLM client) with zero OpenRefine-core dependency</description>
  <url>http://openrefine.org/</url>
  <parent>
    <groupId>org.openrefine</groupId>
    <artifactId>extensions</artifactId>
    <version>3.11.0.01</version>
  </parent>

  <build>
    <finalName>jinrefine-files-engine</finalName>
    <sourceDirectory>src</sourceDirectory>
    <!-- 测试源码放在 test/java（与项目规范一致）：src 是主源码根，测试若留在 src/test/java
         会被 maven-compiler 的主编译一并收录。 -->
    <testSourceDirectory>test/java</testSourceDirectory>
    <plugins>
      <!-- 本模块无 localizer 资源束：显式把 fileMask 限定为一个不存在的名字，
           避免 localizer 按 artifactId（含 '-'）生成非法类名。详见 data-quality/pom.xml 注释。 -->
      <plugin>
        <groupId>org.jvnet.localizer</groupId>
        <artifactId>localizer-maven-plugin</artifactId>
        <configuration>
          <fileMask>no-localizer-bundles.properties</fileMask>
        </configuration>
      </plugin>
      <!-- 覆盖 extensions 父 POM 的 jar 落点（父级缺省写到 module/MOD-INF/lib）。
           本模块是纯类库 jar，直接落 target，由依赖方 FilesExtension 的 copy-dependencies 收口。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <outputDirectory>${project.build.directory}</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- 平台 SDK：授权门（LicenseGate）与 AIMP 契约。provided：运行期由 OR server 主 lib 提供 -->
    <dependency>
      <groupId>com.jiongche</groupId>
      <artifactId>ruyi-platform-sdk</artifactId>
      <version>0.1.1</version>
      <scope>provided</scope>
    </dependency>
    <!-- Jackson（DTO/配置序列化）。provided 的传递依赖不参与编译，故三件均显式声明 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- 单测：与 OR 其余模块同用 TestNG -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
